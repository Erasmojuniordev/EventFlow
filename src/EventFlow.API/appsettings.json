{
  /*
    SEGURANÇA: NUNCA colocar secrets reais aqui!
    Connection strings, JWT secrets, API keys devem vir de:
    1. Variáveis de ambiente (produção)
    2. appsettings.Development.json + .gitignore (desenvolvimento local)
    3. dotnet user-secrets (desenvolvimento local — mais seguro)
    4. Azure Key Vault / AWS Secrets Manager (produção enterprise)

    Este arquivo vai para o Git. Qualquer dado aqui é público.
  */
  "AllowedHosts": "*",

  "JwtSettings": {
    "Issuer": "EventFlow.API",
    "Audience": "EventFlow.Client",
    "ExpirationMinutes": 15
    // "Secret" NÃO está aqui — vem de variável de ambiente JWT_SECRET ou user-secrets
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        // Reduz o ruído de logs do EF Core e Microsoft em produção
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}
